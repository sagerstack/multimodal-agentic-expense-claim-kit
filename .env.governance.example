# Agentic Governance runtime configuration
# Valid control modes: enforce | observe | off
# Governance audit recording has no disable flag.
# Control thresholds live in the governance policy file, not in these mode switches.

# Group A control modes
AGENTIC_GOV_ENABLE_ALLOWLIST=enforce
AGENTIC_GOV_ENABLE_IDENTITY=enforce
AGENTIC_GOV_ENABLE_MANDATE=enforce
AGENTIC_GOV_ENABLE_INTEGRITY=enforce
AGENTIC_GOV_ENABLE_EXPOSURE=enforce
AGENTIC_GOV_ENABLE_RATE=enforce
AGENTIC_GOV_ENABLE_EVIDENCE=enforce
AGENTIC_GOV_ENABLE_SCHEMA=enforce
AGENTIC_GOV_ENABLE_FAIL_CLOSED=enforce

# Test/demo toggles only; leave empty for normal enforcement.
AGENTIC_GOV_DENY_TOOLS=
AGENTIC_GOV_REVOKE_GRANTS=
AGENTIC_GOV_FORCE_IDENTITY=
AGENTIC_GOV_SIMULATE_TAMPER=

# Optional custom policy file (thresholds and policy rules).
# AGENTIC_GOV_POLICY_FILE=/path/to/governance-policy.json
